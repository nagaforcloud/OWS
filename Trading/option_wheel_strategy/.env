# .env - Environment variables for Option Wheel Strategy
# Store your sensitive API keys and tokens here.
# Make sure to replace the placeholder values with your actual credentials.

KITE_API_KEY="YOUR_KITE_API_KEY"
KITE_API_SECRET="YOUR_KITE_API_SECRET"
KITE_ACCESS_TOKEN="YOUR_KITE_ACCESS_TOKEN"

# Trading Parameters
SYMBOL="NIFTY"  # or "TCS" for original
QUANTITY_PER_LOT=50  # NIFTY lot size is 50
PROFIT_TARGET_PERCENTAGE=0.50
LOSS_LIMIT_PERCENTAGE=1.00
OTM_DELTA_RANGE_LOW=0.15
OTM_DELTA_RANGE_HIGH=0.25
MIN_OPEN_INTEREST=1000

# Strategy Timing
STRATEGY_RUN_INTERVAL_SECONDS=300
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30

# Risk Management
MAX_CONCURRENT_POSITIONS=5
MAX_DAILY_LOSS_LIMIT=5000.0
MAX_PORTFOLIO_RISK=0.02

# Notification Settings
ENABLE_NOTIFICATIONS=false
NOTIFICATION_WEBHOOK_URL=""

# Data Settings
USE_NSE_API=true
DATA_REFRESH_INTERVAL=60

# Backtesting Settings
USE_NIFTY=false  # Set to true to use NIFTY data for backtesting